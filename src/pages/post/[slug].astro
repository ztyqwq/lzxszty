---
import { posts } from '../../data/posts';
import type { PostEntry } from '../../data/posts';
import Layout from '../../layouts/Layout.astro';

interface Props {
	post: PostEntry;
}

export function getStaticPaths() {
	return posts.map((post) => ({
		params: { slug: post.slug },
		props: { post },
	}));
}

const { post } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
---

<Layout title={post.title} description={post.summary}>
	<main class="page-shell article-shell">
		<a class="back-link text-link" href={`${baseUrl}post/`}>返回日常</a>
		<article>
			<header class="article-header">
				<time datetime={post.date}>{post.date}</time>
				<h1>{post.title}</h1>
				<p>{post.summary}</p>
			</header>

			<div class="article-body">
				{post.content.map((paragraph) => <p>{paragraph}</p>)}
			</div>
		</article>
	</main>
</Layout>

<style>
	.article-shell {
		max-width: 780px;
	}

	.back-link {
		display: inline-block;
		margin-bottom: 2.2rem;
		color: var(--muted);
		text-decoration: none;
	}

	.article-header {
		padding-bottom: 2rem;
		border-bottom: 1px solid var(--line);
	}

	time {
		color: var(--accent-strong);
		font-family: 'Times New Roman', ui-serif, Georgia, serif;
	}

	h1 {
		margin: 0.7rem 0 0;
		color: var(--text);
		font-size: clamp(2rem, 6vw, 4rem);
		font-weight: 680;
		line-height: 1.15;
		letter-spacing: 0;
	}

	.article-header p,
	.article-body p {
		color: var(--muted);
		font-size: 1.05rem;
		line-height: 1.9;
	}

	.article-body {
		padding-top: 2rem;
	}
</style>
