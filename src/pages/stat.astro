---
import Layout from '../layouts/Layout.astro';

const stats = [
	{ label: '在一起', value: '', suffix: '天', size: 'large', mode: 'since', date: '2026-05-18' },
	{ label: '距离结婚', value: '', suffix: '天', size: 'large', mode: 'until', date: '2030-05-18' },
	{ label: '一起吃饭', value: '0', suffix: '次', size: 'medium' },
	{ label: '对戒', value: '0', suffix: '枚', size: 'small' },
	{ label: '想对方', value: '∞', suffix: '次', size: 'medium' },
	{ label: '网站建立', value: '', suffix: '天', size: 'small', mode: 'since', date: '2026-05-18' },
	{ label: '访问次数', value: '以后再接', suffix: '', size: 'small' },
];
---

<Layout title="数据" description="记录各种重要数字。">
	<main class="page-shell">
		<header class="page-hero">
			<p class="eyebrow">Stat</p>
			<h1 class="page-title">数据</h1>
			<p class="page-lead">先做成静态大小不一的面板；之后可以再讨论滚轮转盘式展示。</p>
		</header>

		<section class="stat-grid" aria-label="恋爱数据">
			{
				stats.map((stat) => (
					<article
						class={`stat-card soft-panel stat-${stat.size}`}
						data-day-stat={stat.mode}
						data-date={stat.date}
					>
						<p>{stat.label}</p>
						<strong>{stat.value}</strong>
						<span>{stat.suffix}</span>
					</article>
				))
			}
		</section>
	</main>

	<script>
		const now = new Date();
		document.querySelectorAll('[data-day-stat]').forEach((card) => {
			const dateValue = card.getAttribute('data-date');
			const mode = card.getAttribute('data-day-stat');
			const strong = card.querySelector('strong');
			if (!dateValue || !strong) return;
			const target = new Date(`${dateValue}T00:00:00`);
			const oneDay = 1000 * 60 * 60 * 24;
			const raw = mode === 'until' ? target.getTime() - now.getTime() : now.getTime() - target.getTime();
			strong.textContent = String(Math.max(0, Math.ceil(raw / oneDay)));
		});
	</script>
</Layout>

<style>
	.stat-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1rem;
	}

	.stat-card {
		min-height: 11rem;
		padding: 1.2rem;
	}

	.stat-large {
		grid-column: span 2;
		min-height: 15rem;
	}

	.stat-medium {
		grid-column: span 2;
	}

	.stat-card p {
		margin: 0;
		color: var(--muted);
	}

	.stat-card strong {
		display: block;
		margin-top: 1.2rem;
		color: var(--accent-strong);
		font-size: clamp(2.6rem, 8vw, 5.5rem);
		line-height: 1;
	}

	.stat-card span {
		color: var(--muted);
	}

	@media (max-width: 820px) {
		.stat-grid {
			grid-template-columns: 1fr;
		}

		.stat-large,
		.stat-medium {
			grid-column: span 1;
		}
	}
</style>
