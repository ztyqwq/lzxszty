---
import Layout from '../layouts/Layout.astro';

const achievements = [
	{ title: '第一篇日常', text: '发布第一篇 post。', state: '占位' },
	{ title: '收集所有点点', text: '未来首页互动完成后可解锁。', state: '构想' },
	{ title: '时间线起点', text: '添加第一条时间线事件。', state: '占位' },
	{ title: '小猫回声', text: '在碎碎念里完成一次回复。', state: '构想' },
];
---

<Layout title="成就" description="一些小成就和互动解锁。">
	<main class="page-shell">
		<header class="page-hero">
			<p class="eyebrow">Achievement</p>
			<h1 class="page-title">成就</h1>
			<p class="page-lead">先放几个占位成就，后续再决定是否用本地存档或构建数据解锁。</p>
		</header>

		<section class="achievement-grid" aria-label="成就列表">
			{achievements.map((item) => (
				<article class="achievement-card soft-panel">
					<span>{item.state}</span>
					<h2>{item.title}</h2>
					<p>{item.text}</p>
				</article>
			))}
		</section>
	</main>
</Layout>

<style>
	.achievement-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1rem;
	}

	.achievement-card {
		min-height: 13rem;
		padding: 1.2rem;
	}

	.achievement-card span {
		color: var(--accent-strong);
		font-size: 0.85rem;
	}

	h2 {
		margin: 1.2rem 0 0.7rem;
		font-size: 1.15rem;
		letter-spacing: 0;
	}

	p {
		margin: 0;
		color: var(--muted);
		line-height: 1.75;
	}

	@media (max-width: 920px) {
		.achievement-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 560px) {
		.achievement-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
