---
import Layout from '../layouts/Layout.astro';

const games = [
	{ title: '小小大富翁', text: '以后可以做成一张轻量棋盘，两个人轮流走。' },
	{ title: '记忆翻牌', text: '用共同照片或图标做翻牌小游戏。' },
	{ title: '今日抽签', text: '抽一个约会地点、晚饭选项或小任务。' },
];
---

<Layout title="小游戏" description="一些可以在网页里玩的小游戏占位。">
	<main class="page-shell">
		<header class="page-hero">
			<p class="eyebrow">Game</p>
			<h1 class="page-title">小游戏</h1>
			<p class="page-lead">先放入口占位，之后可以逐个做成真正可玩的页面。</p>
		</header>

		<section class="game-list">
			{games.map((game) => (
				<article class="game-card soft-panel">
					<h2>{game.title}</h2>
					<p>{game.text}</p>
				</article>
			))}
		</section>
	</main>
</Layout>

<style>
	.game-list {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}

	.game-card {
		padding: 1.4rem;
		min-height: 12rem;
	}

	h2 {
		margin: 0 0 0.8rem;
		font-size: 1.2rem;
		letter-spacing: 0;
	}

	p {
		margin: 0;
		color: var(--muted);
		line-height: 1.8;
	}

	@media (max-width: 760px) {
		.game-list {
			grid-template-columns: 1fr;
		}
	}
</style>
