---
import Layout from '../layouts/Layout.astro';

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
---

<Layout title="lzxszty" description="lzxszty 的私密入口。">
	<main class="spa-root" data-spa-root data-base-url={baseUrl}>
		<section class="home-shell route-view" data-route-view="home">
			<section class="home-hero" aria-label="首页">
				<div class="home-heart" aria-hidden="true" data-heart-art></div>
			</section>
		</section>

		<section class="page-shell route-view" data-route-view="post-list" hidden>
			<header class="post-board-header">
				<h1>小猫的日常</h1>
					<div class="post-board-actions">
						<button class="post-tool-button idea-button" type="button" aria-label="灵感">
							<svg aria-hidden="true" viewBox="0 0 24 24">
								<path d="M12 1.3v2.4" />
								<path d="M3.9 4.7l1.8 1.8" />
								<path d="M20.1 4.7l-1.8 1.8" />
								<path d="M9 18h6" />
								<path d="M10 22h4" />
								<path d="M8.2 14.2a6 6 0 1 1 7.6 0c-.7.55-.8 1.08-.8 1.8H9c0-.72-.1-1.25-.8-1.8Z" />
						</svg>
					</button>
					<a class="post-tool-button" href={`${baseUrl}#/post/new`} aria-label="创建新 post">
						<svg aria-hidden="true" viewBox="0 0 24 24">
							<path d="M12 5v14" />
							<path d="M5 12h14" />
						</svg>
					</a>
				</div>
			</header>

			<section class="post-card-list" aria-label="日常列表" data-post-list></section>
			<nav class="post-pagination" aria-label="日常分页" data-post-pagination></nav>
			<p class="private-status" role="status" data-post-status>等待登录后加载。</p>
		</section>

		<section class="page-shell route-view" data-route-view="post-detail" hidden>
			<article class="post-detail-view">
				<header class="post-detail-header">
					<div class="post-detail-topline">
						<p class="post-detail-meta">
							<span data-post-detail-author></span>
							<span aria-hidden="true">/</span>
							<time data-post-detail-date></time>
						</p>
						<div class="post-detail-actions" data-post-owner-actions hidden>
							<a class="post-icon-action" href={`${baseUrl}#/post/new`} data-post-edit-link aria-label="编辑">
								<svg aria-hidden="true" viewBox="0 0 24 24">
									<path d="M12 20h9" />
									<path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" />
								</svg>
							</a>
							<button class="post-icon-action danger-icon-action" type="button" data-post-delete aria-label="删除">
								<svg aria-hidden="true" viewBox="0 0 24 24">
									<path d="M3 6h18" />
									<path d="M8 6V4h8v2" />
									<path d="M19 6l-1 15H6L5 6" />
									<path d="M10 11v6" />
									<path d="M14 11v6" />
								</svg>
							</button>
						</div>
					</div>
					<h1 data-post-detail-title></h1>
				</header>

				<div class="post-detail-image" data-post-detail-image hidden></div>
				<div class="markdown-body" data-post-detail-body></div>
			</article>
			<p class="private-status detail-status" role="status" data-post-detail-status>等待登录后加载。</p>

			<dialog class="delete-dialog" data-delete-dialog>
				<form method="dialog" class="delete-dialog-card">
					<p>真的要删除吗？小猫会心疼的……</p>
					<div>
						<button class="safe-cancel-button" type="button" data-delete-cancel>搞戳了！</button>
						<button class="danger-confirm-button" type="button" data-delete-confirm>嗯喵</button>
					</div>
				</form>
			</dialog>
		</section>

		<section class="page-shell route-view" data-route-view="post-edit" hidden>
			<header class="editor-hero">
				<a class="editor-back-link" href={`${baseUrl}#/post`} data-editor-back-link aria-label="返回">
					<svg aria-hidden="true" viewBox="0 0 24 24">
						<path d="M15 18l-6-6 6-6" />
						<path d="M9 12h12" />
					</svg>
				</a>
				<h1 class="page-title" data-editor-title>小猫今天在想什么？</h1>
			</header>

			<form class="editor-layout" data-editor-form>
				<section class="editor-panel soft-panel" aria-label="日常编辑">
					<label>
						<span>标题</span>
						<input name="title" type="text" autocomplete="off" />
					</label>

					<label>
						<span>Post name</span>
						<input
							name="slug"
							type="text"
							autocomplete="off"
							inputmode="latin"
							placeholder="确定后无法修改"
						/>
					</label>

					<label>
						<span>标签</span>
						<input name="tags" type="text" autocomplete="off" placeholder="用逗号分隔" />
					</label>

					<label>
						<span>Markdown 正文</span>
						<textarea name="body" rows="18"></textarea>
					</label>

					<div class="editor-actions">
						<button type="button" class="image-upload-button" data-image-upload>插入图片</button>
						<button type="submit" data-save-post>发送喵喵！</button>
					</div>
					<input
						class="visually-hidden"
						type="file"
						accept="image/*"
						multiple
						data-image-input
					/>
				</section>

				<section class="preview-panel soft-panel" aria-label="Markdown 预览">
					<p class="preview-label">Preview</p>
					<div class="markdown-body" data-editor-preview></div>
				</section>
			</form>

			<p class="private-status" role="status" data-editor-status>等待登录后加载。</p>
		</section>

		<section class="page-shell route-view" data-route-view="stat" hidden>
			<header class="post-board-header stat-board-header">
				<h1>小猫记得的数字</h1>
				<button class="post-tool-button" type="button" aria-label="编辑数据" data-stat-edit-toggle>
					<svg aria-hidden="true" viewBox="0 0 24 24">
						<path d="M12 20h9" />
						<path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" />
					</svg>
				</button>
			</header>

			<section class="stat-list" aria-label="小猫记得的数字" data-stat-list>
				<p class="empty-state" data-stat-empty>等待登录后加载。</p>
			</section>
			<p class="private-status" role="status" data-stat-status></p>

			<dialog class="delete-dialog" data-stat-delete-dialog>
				<form method="dialog" class="delete-dialog-card">
					<p>真的要删除吗？小猫会心疼的……</p>
					<div>
						<button class="danger-confirm-button" type="button" data-stat-delete-confirm>嗯喵</button>
						<button type="button" data-stat-delete-cancel>搞戳了！</button>
					</div>
				</form>
			</dialog>
		</section>

		<section class="page-shell timeline-shell route-view" data-route-view="timeline" hidden>
			<header class="page-hero">
				<p class="eyebrow">Timeline</p>
				<h1 class="page-title">时间线</h1>
				<p class="page-lead">登录后从 Supabase 读取时间线事件。</p>
			</header>

			<section class="timeline-frame soft-panel" aria-label="时间线" data-horizontal-timeline>
				<div class="timeline-track" data-timeline-track></div>
				<p class="empty-state" data-timeline-empty>等待登录后加载。</p>
			</section>
		</section>

		<section class="page-shell route-view" data-route-view="gallery" hidden>
			<header class="page-hero gallery-hero">
				<div>
					<p class="eyebrow">Gallery</p>
					<h1 class="page-title">画廊</h1>
					<p class="page-lead">登录后从 Supabase 读取照片和图片。</p>
				</div>
			</header>

			<section class="gallery-grid" aria-label="画廊" data-gallery-grid>
				<p class="empty-state" data-gallery-empty>等待登录后加载。</p>
			</section>

			<dialog class="gallery-dialog" data-gallery-dialog>
				<button type="button" class="gallery-dialog-close" data-gallery-close>关闭</button>
				<div class="gallery-dialog-image" data-gallery-dialog-image></div>
				<div class="gallery-dialog-copy">
					<h2 data-gallery-dialog-title></h2>
					<p data-gallery-dialog-body></p>
					<time data-gallery-dialog-date></time>
				</div>
			</dialog>
		</section>

		<section class="page-shell meow-shell route-view" data-route-view="meow" hidden>
			<header class="page-hero">
				<p class="eyebrow">Meow</p>
				<h1 class="page-title">小猫</h1>
				<p class="page-lead">两只小猫会根据心情抬高或放低尾巴。登录账号决定你正在操作哪一只。</p>
			</header>

			<section class="cats-stage" aria-label="两只小猫">
				<article class="cat-card cat-card-left soft-panel" data-cat-card="black">
					<div class="cat-scene">
						<div class="cat-body cat-black" data-cat-body="black">
							<span class="cat-tail"></span>
							<span class="cat-ear cat-ear-left"></span>
							<span class="cat-ear cat-ear-right"></span>
							<span class="cat-eye cat-eye-left"></span>
							<span class="cat-eye cat-eye-right"></span>
							<span class="cat-mouth"></span>
						</div>
					</div>
					<div class="cat-info">
						<h2 data-cat-name="black">黑色小猫</h2>
						<p data-cat-owner="black">等待登录后加载。</p>
						<label>
							<span>心情</span>
							<meter min="0" max="100" value="50" data-cat-mood="black"></meter>
						</label>
						<label>
							<span>好感度</span>
							<meter min="0" max="100" value="50" data-cat-affection="black"></meter>
						</label>
					</div>
				</article>

				<article class="cat-card cat-card-right soft-panel" data-cat-card="white">
					<div class="cat-scene">
						<div class="cat-body cat-white" data-cat-body="white">
							<span class="cat-tail"></span>
							<span class="cat-ear cat-ear-left"></span>
							<span class="cat-ear cat-ear-right"></span>
							<span class="cat-eye cat-eye-left"></span>
							<span class="cat-eye cat-eye-right"></span>
							<span class="cat-mouth"></span>
						</div>
					</div>
					<div class="cat-info">
						<h2 data-cat-name="white">白色小猫</h2>
						<p data-cat-owner="white">等待登录后加载。</p>
						<label>
							<span>心情</span>
							<meter min="0" max="100" value="50" data-cat-mood="white"></meter>
						</label>
						<label>
							<span>好感度</span>
							<meter min="0" max="100" value="50" data-cat-affection="white"></meter>
						</label>
					</div>
				</article>
			</section>

			<section class="meow-controls soft-panel" aria-label="小猫操作">
				<div>
					<p class="control-kicker">Actions</p>
					<h2 data-active-cat-title>等待登录</h2>
					<p data-meow-status role="status">登录后可以投食、喵喵叫和留言。</p>
				</div>

				<div class="action-row">
					<button type="button" data-feed-button>给对方投食</button>
					<button type="button" data-meow-button>喵喵叫</button>
				</div>

				<form class="message-form" data-message-form>
					<label>
						<span>留言</span>
						<input type="text" name="message" maxlength="180" autocomplete="off" placeholder="写一句话" />
					</label>
					<button type="submit">发送</button>
				</form>
			</section>

			<section class="meow-chat soft-panel" aria-label="小猫留言" data-message-list>
				<p class="empty-state" data-message-empty>等待登录后加载。</p>
			</section>
		</section>

		<section class="page-shell route-view" data-route-view="achievement" hidden>
			<header class="page-hero">
				<p class="eyebrow">Achievement</p>
				<h1 class="page-title">成就</h1>
				<p class="page-lead">登录后从 Supabase 读取成就列表。</p>
			</header>

			<section class="achievement-grid" aria-label="成就列表" data-achievement-grid>
				<p class="empty-state" data-achievement-empty>等待登录后加载。</p>
			</section>
		</section>

		<section class="page-shell route-view" data-route-view="game" hidden>
			<header class="page-hero">
				<p class="eyebrow">Game</p>
				<h1 class="page-title">小游戏</h1>
				<p class="page-lead">登录后从 Supabase 读取小游戏入口。</p>
			</header>

			<section class="game-list" data-game-list>
				<p class="empty-state" data-game-empty>等待登录后加载。</p>
			</section>
		</section>

		<section class="page-shell route-view" data-route-view="about" hidden>
			<header class="page-hero">
				<p class="eyebrow">About</p>
				<h1 class="page-title">关于</h1>
				<p class="page-lead">登录后从 Supabase 读取网站信息和更新历史。</p>
			</header>

			<section class="about-grid" data-about-grid>
				<p class="empty-state" data-about-empty>等待登录后加载。</p>
			</section>
		</section>

		<section class="page-shell route-view" data-route-view="missing" hidden>
			<section class="soft-panel route-missing">
				<h1>没有这个页面</h1>
				<p>这个 hash 路由暂时不存在。</p>
				<a class="text-link" href={`${baseUrl}#/`}>返回首页</a>
			</section>
		</section>
	</main>

	<script>
		import {
			catLabel,
			formatDate,
			getPrivateImageUrl,
			onPrivateContentReady,
			renderMarkdown,
			setStatus,
		} from '../lib/private-content';
		import { supabase } from '../lib/supabase';

		const PAGE_SIZE = 10;
		const root = document.querySelector('[data-spa-root]');
		const baseUrl = root instanceof HTMLElement ? root.dataset.baseUrl || '/' : '/';
		const views = Array.from(document.querySelectorAll('[data-route-view]'));
		const heartArt = document.querySelector('[data-heart-art]');
		let currentCat = '';
		let currentRoute = { view: 'home', section: 'home' };
		let postChannel = null;
		let statChannel = null;
		let meowChannel = null;
		let meowEventsBound = false;

		const homeNodes = {
			eyebrow: document.querySelector('[data-home-eyebrow]'),
			title: document.querySelector('[data-home-title]'),
			lead: document.querySelector('[data-home-lead]'),
			panel: document.querySelector('[data-home-panel]'),
		};

		const postNodes = {
			list: document.querySelector('[data-post-list]'),
			pagination: document.querySelector('[data-post-pagination]'),
			listMeta: document.querySelector('[data-post-list-meta]'),
			status: document.querySelector('[data-post-status]'),
			detailStatus: document.querySelector('[data-post-detail-status]'),
			detailAuthor: document.querySelector('[data-post-detail-author]'),
			detailDate: document.querySelector('[data-post-detail-date]'),
			detailTitle: document.querySelector('[data-post-detail-title]'),
			detailSummary: document.querySelector('[data-post-detail-summary]'),
			detailBody: document.querySelector('[data-post-detail-body]'),
			detailImage: document.querySelector('[data-post-detail-image]'),
			ownerActions: document.querySelector('[data-post-owner-actions]'),
			editLink: document.querySelector('[data-post-edit-link]'),
			deleteButton: document.querySelector('[data-post-delete]'),
			deleteDialog: document.querySelector('[data-delete-dialog]'),
			deleteConfirm: document.querySelector('[data-delete-confirm]'),
			deleteCancel: document.querySelector('[data-delete-cancel]'),
		};

		const editorNodes = {
			form: document.querySelector('[data-editor-form]'),
			title: document.querySelector('[data-editor-form] input[name="title"]'),
			slug: document.querySelector('[data-editor-form] input[name="slug"]'),
			tags: document.querySelector('[data-editor-form] input[name="tags"]'),
			body: document.querySelector('[data-editor-form] textarea[name="body"]'),
			saveButton: document.querySelector('[data-save-post]'),
			imageUploadButton: document.querySelector('[data-image-upload]'),
				imageInput: document.querySelector('[data-image-input]'),
				deleteButton: document.querySelector('[data-editor-delete-post]'),
				status: document.querySelector('[data-editor-status]'),
				preview: document.querySelector('[data-editor-preview]'),
				titleNode: document.querySelector('[data-editor-title]'),
				backLink: document.querySelector('[data-editor-back-link]'),
			};
		let slugTouched = false;
		let loadedPost = null;
		let pendingDeleteSlug = '';
		let editorDraftId = crypto.randomUUID?.() || `${Date.now()}-${Math.random().toString(16).slice(2)}`;

		const editorPrompts = ['小猫今天在想什么？', '写点什么咪？', '小猫今天有没有想咪？'];

		const statNodes = {
			list: document.querySelector('[data-stat-list]'),
			empty: document.querySelector('[data-stat-empty]'),
			status: document.querySelector('[data-stat-status]'),
			editToggle: document.querySelector('[data-stat-edit-toggle]'),
			deleteDialog: document.querySelector('[data-stat-delete-dialog]'),
			deleteConfirm: document.querySelector('[data-stat-delete-confirm]'),
			deleteCancel: document.querySelector('[data-stat-delete-cancel]'),
			};
			let statItems = [];
			let statDraftItems = [];
			let statDeletedIds = new Set();
			let statEditMode = false;
			let statSaveInProgress = false;
			let pendingStatDeleteId = '';

		const timelineNodes = {
			frame: document.querySelector('[data-horizontal-timeline]'),
			track: document.querySelector('[data-timeline-track]'),
			empty: document.querySelector('[data-timeline-empty]'),
		};

		const galleryNodes = {
			grid: document.querySelector('[data-gallery-grid]'),
			empty: document.querySelector('[data-gallery-empty]'),
			dialog: document.querySelector('[data-gallery-dialog]'),
			close: document.querySelector('[data-gallery-close]'),
			dialogImage: document.querySelector('[data-gallery-dialog-image]'),
			dialogTitle: document.querySelector('[data-gallery-dialog-title]'),
			dialogBody: document.querySelector('[data-gallery-dialog-body]'),
			dialogDate: document.querySelector('[data-gallery-dialog-date]'),
		};

		const meowNodes = {
			feedButton: document.querySelector('[data-feed-button]'),
			meowButton: document.querySelector('[data-meow-button]'),
			form: document.querySelector('[data-message-form]'),
			input: document.querySelector('[data-message-form] input[name="message"]'),
			list: document.querySelector('[data-message-list]'),
			empty: document.querySelector('[data-message-empty]'),
			status: document.querySelector('[data-meow-status]'),
			activeTitle: document.querySelector('[data-active-cat-title]'),
		};

		function renderHeartArt() {
			if (!heartArt) return;
			const columns = 45;
			const rows = 29;
			const chars = ['想', '咪'];
			heartArt.innerHTML = '';
			for (let rowIndex = 0; rowIndex < rows; rowIndex += 1) {
				const row = document.createElement('div');
				row.className = 'heart-row';
				row.style.gridTemplateColumns = `repeat(${columns}, 0.78em)`;
				for (let colIndex = 0; colIndex < columns; colIndex += 1) {
					const x = (colIndex / (columns - 1)) * 3.0 - 1.5;
					const y = 1.32 - (rowIndex / (rows - 1)) * 2.72;
					const shape = (x * x + y * y - 1) ** 3 - x * x * y ** 3;
					const filled = shape <= 0;
					const span = document.createElement('span');
					span.className = filled ? 'heart-cell is-filled' : 'heart-cell';
					if (filled) {
						span.textContent = chars[(rowIndex + colIndex) % chars.length];
						const rowTone = rowIndex / (rows - 1);
						const colTone = Math.abs(colIndex - (columns - 1) / 2) / ((columns - 1) / 2);
						const lightness = 76 - rowTone * 24 - colTone * 7;
						const saturation = 87 - rowTone * 4;
						span.style.setProperty('--heart-color', `hsl(340 ${saturation}% ${lightness}%)`);
					}
					row.append(span);
				}
				heartArt.append(row);
			}
		}

		renderHeartArt();

		function withBase(hashPath) {
			return `${baseUrl}#${hashPath.startsWith('/') ? hashPath : `/${hashPath}`}`;
		}

		function normalizePath(path) {
			const clean = `/${String(path || '/').replace(/^\/+/, '')}`.replace(/\/+$/, '');
			return clean === '' ? '/' : clean;
		}

		function parseRoute() {
			const rawHash = window.location.hash || '#/';
			const hashBody = rawHash.startsWith('#') ? rawHash.slice(1) : rawHash;
			const [pathPart, queryPart = ''] = hashBody.split('?');
			const path = normalizePath(decodeURIComponent(pathPart || '/'));
			const query = new URLSearchParams(queryPart);
			const legacySlug = query.get('slug');

			if (path === '/') return { view: 'home', section: 'home', title: 'lzxszty' };
			if (path === '/post' && legacySlug) {
				return { view: 'post-detail', section: 'post', slug: legacySlug, title: '日常' };
			}
			if (path === '/post') return { view: 'post-list', section: 'post', page: 1, title: '日常' };
			if (path === '/post/new') {
				return { view: 'post-edit', section: 'post', slug: '', title: '写新日常' };
			}

			const postEdit = path.match(/^\/post\/([^/]+)\/edit$/);
			if (postEdit) {
				return {
					view: 'post-edit',
					section: 'post',
					slug: decodeURIComponent(postEdit[1]),
					title: '编辑日常',
				};
			}

			const postPage = path.match(/^\/post\/page\/([1-9]\d*)$/);
			if (postPage) {
				return { view: 'post-list', section: 'post', page: Number(postPage[1]), title: '日常' };
			}

			const postSlug = path.match(/^\/post\/([^/]+)$/);
			if (postSlug && !['page', 'edit'].includes(postSlug[1])) {
				return {
					view: 'post-detail',
					section: 'post',
					slug: decodeURIComponent(postSlug[1]),
					title: '日常',
				};
			}

			const simpleRoutes = new Set(['stat', 'timeline', 'gallery', 'meow', 'achievement', 'game', 'about']);
			const simple = path.match(/^\/([^/]+)$/);
			if (simple && simpleRoutes.has(simple[1])) {
				return { view: simple[1], section: simple[1], title: routeTitle(simple[1]) };
			}

			return { view: 'missing', section: '', title: '页面不存在' };
		}

		function routeTitle(view) {
			return (
				{
					home: 'lzxszty',
					post: '日常',
					stat: '数据',
					timeline: '时间线',
					gallery: '画廊',
					meow: '小猫',
					achievement: '成就',
					game: '小游戏',
					about: '关于',
				}[view] || 'lzxszty'
			);
		}

		function showView(viewName) {
			views.forEach((view) => {
				const shouldShow = view.getAttribute('data-route-view') === viewName;
				view.toggleAttribute('hidden', !shouldShow);
				if (shouldShow) {
					view.setAttribute('data-route-active', 'false');
					window.requestAnimationFrame(() => {
						view.setAttribute('data-route-active', 'true');
					});
				} else {
					view.removeAttribute('data-route-active');
				}
			});
		}

		function updateNav(section) {
			document.querySelectorAll('.site-nav a').forEach((link) => {
				if (!(link instanceof HTMLAnchorElement)) return;
				const hash = link.hash || '#/';
				const isHome = section === 'home' && hash === '#/';
				const isMatch = section !== 'home' && hash === `#/${section}`;
				if (isHome || isMatch) {
					link.setAttribute('aria-current', 'page');
				} else {
					link.removeAttribute('aria-current');
				}
			});
		}

		function firstParagraph(body) {
			return (
				String(body || '')
					.split(/\n{2,}/)
					.map((part) => part.replace(/^#{1,6}\s+/, '').trim())
					.find(Boolean) || ''
			);
		}

		function stripMarkdownForPreview(value) {
			return String(value || '')
				.replace(/!\[[^\]]*\]\([^)]+\)/g, ' ')
				.replace(/^#{1,6}\s+/gm, '')
				.replace(/[*_`>#-]/g, '')
				.replace(/\s+/g, ' ')
				.trim();
		}

		function postPreviewText(body) {
			const source = String(body || '').replace(/\r\n/g, '\n');
			const lines = source
				.split('\n')
				.map(stripMarkdownForPreview)
				.filter(Boolean);
			if (!lines.length) return '';
			const first = lines[0];
			const hasMore = lines.length > 1;
			return hasMore && !first.endsWith('...') && !first.endsWith('……') ? `${first}...` : first;
		}

		function extractPrivateImagePaths(markdown) {
			return Array.from(String(markdown || '').matchAll(/!\[[^\]]*\]\(love-private:([^)]+)\)/g)).map(
				(match) => match[1],
			);
		}

		async function resolvePostPreviewImages(post) {
			const paths = [];
			if (post.hero_image_path) paths.push(post.hero_image_path);
			extractPrivateImagePaths(post.body).forEach((path) => {
				if (!paths.includes(path)) paths.push(path);
			});

			const urls = [];
			for (const path of paths.slice(0, 3)) {
				const url = await getPrivateImageUrl(path);
				if (url) urls.push(url);
			}
			return urls;
		}

		function setElementText(node, value) {
			if (node) node.textContent = value || '';
		}

		function escapeInlineHtml(value) {
			return String(value || '')
				.replace(/&/g, '&amp;')
				.replace(/</g, '&lt;')
				.replace(/>/g, '&gt;')
				.replace(/"/g, '&quot;')
				.replace(/'/g, '&#39;');
		}

		function renderInlineMarkdown(value) {
			return escapeInlineHtml(value)
				.replace(/`([^`]+)`/g, '<code>$1</code>')
				.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
				.replace(/\*([^*]+)\*/g, '<em>$1</em>');
		}

		function formatDateTime(value) {
			if (!value) return '';
			const date = new Date(value);
			if (Number.isNaN(date.getTime())) return formatDate(value);
			const yyyy = date.getFullYear();
			const mm = String(date.getMonth() + 1).padStart(2, '0');
			const dd = String(date.getDate()).padStart(2, '0');
			const hh = String(date.getHours()).padStart(2, '0');
			const min = String(date.getMinutes()).padStart(2, '0');
			return `${yyyy}-${mm}-${dd} ${hh}:${min}`;
		}

		function randomEditorPrompt() {
			return editorPrompts[Math.floor(Math.random() * editorPrompts.length)];
		}

		function sanitizeFileName(name) {
			return String(name || 'image')
				.toLowerCase()
				.replace(/\.[^.]+$/, '')
				.replace(/[^a-z0-9-]+/g, '-')
				.replace(/-+/g, '-')
				.replace(/^-|-$/g, '')
				.slice(0, 48) || 'image';
		}

		function imageExtension(file) {
			const byType = {
				'image/jpeg': 'jpg',
				'image/png': 'png',
				'image/webp': 'webp',
				'image/gif': 'gif',
				'image/avif': 'avif',
			};
			if (byType[file.type]) return byType[file.type];
			const fromName = file.name?.match(/\.([a-z0-9]+)$/i)?.[1];
			return fromName ? fromName.toLowerCase() : 'png';
		}

		function currentImageFolder() {
			const slugValue =
				currentRoute.slug ||
				(editorNodes.slug instanceof HTMLInputElement ? slugify(editorNodes.slug.value) : '');
			if (slugValue) return `posts/${slugValue}`;
			return `drafts/${editorDraftId}`;
		}

		function insertAtCursor(textarea, text) {
			const start = textarea.selectionStart ?? textarea.value.length;
			const end = textarea.selectionEnd ?? textarea.value.length;
			const before = textarea.value.slice(0, start);
			const after = textarea.value.slice(end);
			const prefix = before && !before.endsWith('\n') ? '\n\n' : '';
			const suffix = after && !after.startsWith('\n') ? '\n\n' : '';
			const insertText = `${prefix}${text}${suffix}`;
			textarea.value = `${before}${insertText}${after}`;
			const cursor = before.length + insertText.length;
			textarea.focus();
			textarea.setSelectionRange(cursor, cursor);
			textarea.dispatchEvent(new Event('input', { bubbles: true }));
		}

		async function uploadEditorImage(file) {
			if (!supabase) throw new Error('Supabase 未配置。');
			if (!file.type.startsWith('image/')) throw new Error('只能上传图片。');
			const maxSize = 10 * 1024 * 1024;
			if (file.size > maxSize) throw new Error('图片不能超过 10MB。');

			const id = crypto.randomUUID?.() || `${Date.now()}-${Math.random().toString(16).slice(2)}`;
			const path = `${currentImageFolder()}/${id}-${sanitizeFileName(file.name)}.${imageExtension(file)}`;
			const { error } = await supabase.storage.from('love-private').upload(path, file, {
				cacheControl: '3600',
				contentType: file.type || 'image/png',
				upsert: false,
			});
			if (error) throw error;
			return path;
		}

		async function insertEditorImages(files) {
			if (!(editorNodes.body instanceof HTMLTextAreaElement)) return;
			const images = Array.from(files || []).filter((file) => file.type.startsWith('image/'));
			if (!images.length) return;

			setStatus(editorNodes.status, `正在上传 ${images.length} 张图片。`);
			try {
				for (const image of images) {
					const path = await uploadEditorImage(image);
					insertAtCursor(editorNodes.body, `![图片](love-private:${path})`);
				}
				setStatus(editorNodes.status, '图片已插入。', 'ok');
				await updateEditorPreview();
			} catch (error) {
				setStatus(editorNodes.status, `图片上传失败：${error.message || error}`, 'error');
			}
		}

		async function renderPrivateMarkdown(markdown) {
			const source = String(markdown || '');
			const matches = Array.from(source.matchAll(/!\[([^\]]*)\]\(love-private:([^)]+)\)/g));
			if (!matches.length) return renderMarkdown(source);

			let renderedSource = source;
			const replacements = await Promise.all(
				matches.map(async (match) => {
					const signedUrl = await getPrivateImageUrl(match[2]);
					return {
						from: match[0],
						to: signedUrl ? `![${match[1]}](${signedUrl})` : match[0],
					};
				}),
			);
			replacements.forEach(({ from, to }) => {
				renderedSource = renderedSource.replace(from, to);
			});
			return renderMarkdown(renderedSource);
		}

		async function renderImageBox(node, path, label) {
			if (!(node instanceof HTMLElement)) return;
			node.innerHTML = '';

			const imageUrl = await getPrivateImageUrl(path);
			if (!imageUrl) {
				node.setAttribute('hidden', '');
				return;
			}

			node.removeAttribute('hidden');
			if (imageUrl) {
				const image = document.createElement('img');
				image.src = imageUrl;
				image.alt = label || '';
				node.append(image);
				return;
			}
		}

		async function loadHome() {
			return;
		}

		function renderEmpty(container, message) {
			if (!container) return;
			container.innerHTML = '';
			const empty = document.createElement('p');
			empty.className = 'empty-state';
			empty.textContent = message;
			container.append(empty);
		}

		async function renderPostCard(post) {
			const card = document.createElement('article');
			card.className = 'post-card';
			const previewImages = await resolvePostPreviewImages(post);
			if (previewImages.length) card.classList.add('has-image');

			const cat = document.createElement('span');
			cat.className = `post-cat-mark cat-${post.author || 'unknown'}`;
			cat.setAttribute('aria-label', catLabel(post.author));
			cat.title = catLabel(post.author);
			cat.innerHTML = `
				<span class="post-cat-eye post-cat-eye-left"></span>
				<span class="post-cat-eye post-cat-eye-right"></span>
				<span class="post-cat-mouth"></span>
			`;

			const content = document.createElement('div');
			content.className = 'post-card-content';

			const title = document.createElement('a');
			title.className = 'post-card-title';
