			link.className = `timeline-event event-${event.importance || 'medium'}`;
			link.href = event.post_slug ? withBase(`/post/${encodeURIComponent(event.post_slug)}`) : withBase('/timeline');

			const imageUrl = await getPrivateImageUrl(event.image_path);
			if (imageUrl) {
				const image = document.createElement('img');
				image.src = imageUrl;
				image.alt = '';
				link.append(image);
			}

			const date = document.createElement('span');
			date.className = 'event-date';
			date.textContent = formatDate(event.event_date);
			link.append(date);

			const title = document.createElement('strong');
			title.textContent = event.title || '';
			link.append(title);

			if (event.body) {
				const body = document.createElement('span');
				body.textContent = event.body;
				link.append(body);
			}

			return link;
		}

