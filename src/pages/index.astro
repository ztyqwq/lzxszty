			setElementText(galleryNodes.dialogTitle, item.title || '未命名图片');
			setElementText(galleryNodes.dialogBody, item.body || '');
			if (galleryNodes.dialogDate) {
				galleryNodes.dialogDate.textContent = formatDate(item.captured_at || item.created_at);
				galleryNodes.dialogDate.setAttribute('datetime', formatDate(item.captured_at || item.created_at));
