		function partnerOf(catId) {
			return catId === 'black' ? 'white' : 'black';
		}

		function setMeowControlsDisabled(disabled) {
			[
				meowNodes.feedButton,
				meowNodes.meowButton,
				meowNodes.input,
				meowNodes.form?.querySelector('button[type="submit"]'),
			].forEach((node) => {
				if (node instanceof HTMLButtonElement || node instanceof HTMLInputElement) node.disabled = disabled;
			});
		}

		function tailAngle(mood) {
			const safeMood = Math.max(0, Math.min(100, Number(mood) || 0));
			return 54 - safeMood * 1.05;
		}

		function renderCat(cat) {
			const id = cat.id;
			const card = document.querySelector(`[data-cat-card="${id}"]`);
			const body = document.querySelector(`[data-cat-body="${id}"]`);
			const name = document.querySelector(`[data-cat-name="${id}"]`);
			const owner = document.querySelector(`[data-cat-owner="${id}"]`);
			const mood = document.querySelector(`[data-cat-mood="${id}"]`);
			const affection = document.querySelector(`[data-cat-affection="${id}"]`);

			card?.classList.toggle('is-active', id === currentCat);
			card?.classList.toggle('is-partner', id === partnerOf(currentCat));
			if (body instanceof HTMLElement) body.style.setProperty('--tail-angle', `${tailAngle(cat.mood)}`);
			setElementText(name, cat.name || (id === 'black' ? '黑色小猫' : '白色小猫'));
			setElementText(owner, id === currentCat ? '这是你正在操作的小猫。' : '这是对方的小猫。');
			if (mood instanceof HTMLMeterElement) mood.value = Number(cat.mood ?? 0);
			if (affection instanceof HTMLMeterElement) affection.value = Number(cat.affection ?? 0);
		}

