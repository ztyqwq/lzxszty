		function makePageLink(label, page, current = false) {
			const link = document.createElement('a');
			link.href = page <= 1 ? withBase('/post') : withBase(`/post/page/${page}`);
			link.textContent = label;
			if (current) link.setAttribute('aria-current', 'page');
			return link;
		}

		function renderPagination(currentPage, totalPages) {
			if (!postNodes.pagination) return;
			postNodes.pagination.innerHTML = '';
			if (totalPages <= 1) return;

			const pages = new Set([1, totalPages, currentPage - 1, currentPage, currentPage + 1]);
			const visiblePages = Array.from(pages)
				.filter((page) => page >= 1 && page <= totalPages)
				.sort((a, b) => a - b);

			if (currentPage > 1) postNodes.pagination.append(makePageLink('上一页', currentPage - 1));

			let lastPage = 0;
			visiblePages.forEach((page) => {
				if (page - lastPage > 1) {
					const dots = document.createElement('span');
					dots.textContent = '...';
					postNodes.pagination.append(dots);
				}
				postNodes.pagination.append(makePageLink(String(page), page, page === currentPage));
				lastPage = page;
			});

			if (currentPage < totalPages) postNodes.pagination.append(makePageLink('下一页', currentPage + 1));
		}

		async function queryPostPage(selectFields, from, to) {
			return supabase
				.from('love_posts')
				.select(selectFields, { count: 'exact' })
				.order('published_at', { ascending: false })
				.order('created_at', { ascending: false })
				.range(from, to);
		}

		async function loadPostList(page) {
			if (!supabase) return;
			setStatus(postNodes.status, '正在加载日常列表。');
			const from = (page - 1) * PAGE_SIZE;
			const to = from + PAGE_SIZE - 1;
			const baseSelect = 'slug,title,body,tags,author,hero_image_path,published_at,created_at';
			let { data, error, count } = await queryPostPage(
				`${baseSelect},like_count,comment_count`,
				from,
				to,
			);

			if (error && /like_count|comment_count/i.test(error.message || '')) {
				({ data, error, count } = await queryPostPage(baseSelect, from, to));
			}

			if (error) {
				renderEmpty(postNodes.list, '读取失败。');
				setStatus(postNodes.status, `日常读取失败：${error.message}`, 'error');
				return;
			}

			const total = count || 0;
			const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
			setElementText(
				postNodes.listMeta,
				total ? `第 ${page} / ${totalPages} 页，共 ${total} 篇。` : '还没有日常。',
			);

			if (!data?.length) {
				renderEmpty(postNodes.list, page > totalPages ? '这一页暂时没有内容。' : '还没有日常内容。');
				renderPagination(page, totalPages);
				setStatus(postNodes.status, '日常列表已加载。', 'ok');
				return;
			}

			if (postNodes.list) {
				postNodes.list.innerHTML = '';
				const cards = await Promise.all(data.map(renderPostCard));
				cards.forEach((card) => postNodes.list.append(card));
			}
			renderPagination(page, totalPages);
			setStatus(postNodes.status, '日常列表已加载。', 'ok');
		}

			async function loadPostDetail(slug) {
				if (!supabase) return;
				setStatus(postNodes.detailStatus, '正在加载正文。');
				if (postNodes.ownerActions instanceof HTMLElement) postNodes.ownerActions.hidden = true;
				if (postNodes.editLink instanceof HTMLAnchorElement) {
					postNodes.editLink.removeAttribute('href');
					postNodes.editLink.setAttribute('aria-disabled', 'true');
				}
				if (postNodes.deleteButton instanceof HTMLButtonElement) delete postNodes.deleteButton.dataset.slug;
				const { data, error } = await supabase
					.from('love_posts')
					.select('slug,title,body,tags,author,hero_image_path,published_at,created_at,updated_at')
				.eq('slug', slug)
				.maybeSingle();

			if (error) {
				setStatus(postNodes.detailStatus, `正文读取失败：${error.message}`, 'error');
				return;
			}

			if (!data) {
				await loadMissing('没有找到这篇日常。');
				return;
			}

			setElementText(postNodes.detailAuthor, catLabel(data.author));
			if (postNodes.detailDate) {
				const dateValue = data.created_at || data.published_at;
				postNodes.detailDate.textContent = formatDateTime(dateValue);
				postNodes.detailDate.setAttribute('datetime', dateValue || '');
			}
			setElementText(postNodes.detailTitle, data.title || '');
			if (postNodes.detailBody) postNodes.detailBody.innerHTML = await renderPrivateMarkdown(data.body);
				await renderImageBox(postNodes.detailImage, data.hero_image_path, data.title);

				let actorCat = currentCat;
				const { data: rpcCat } = await supabase.rpc('love_current_cat');
				if (rpcCat === 'black' || rpcCat === 'white') {
					actorCat = rpcCat;
					currentCat = rpcCat;
				}
				const canEdit = Boolean(actorCat && data.author === actorCat);
				if (postNodes.ownerActions instanceof HTMLElement) postNodes.ownerActions.hidden = !canEdit;
				if (canEdit && postNodes.editLink instanceof HTMLAnchorElement) {
					postNodes.editLink.href = withBase(`/post/${encodeURIComponent(data.slug)}/edit`);
					postNodes.editLink.removeAttribute('aria-disabled');
				}
				if (canEdit && postNodes.deleteButton instanceof HTMLButtonElement) {
					postNodes.deleteButton.dataset.slug = data.slug;
				}
			setStatus(postNodes.detailStatus, '', 'ok');
		}

		function slugify(value) {
			const slugValue = String(value || '')
				.toLowerCase()
				.trim()
				.replace(/[^a-z0-9-]+/g, '-')
				.replace(/-+/g, '-')
				.replace(/^-|-$/g, '');
			if (slugValue) return slugValue;

			const now = new Date();
			return `post-${now.getFullYear()}${String(now.getMonth() + 1).padStart(2, '0')}${String(
				now.getDate(),
			).padStart(2, '0')}${String(now.getHours()).padStart(2, '0')}${String(now.getMinutes()).padStart(
				2,
				'0',
			)}`;
		}

		function parseTags(value) {
			return String(value || '')
				.split(/[,\n，]+/)
				.map((item) => item.trim())
				.filter(Boolean)
				.slice(0, 12);
		}

		function setEditorDisabled(disabled) {
			editorNodes.form?.querySelectorAll('input, textarea, button').forEach((node) => {
				if (
					node instanceof HTMLInputElement ||
					node instanceof HTMLTextAreaElement ||
					node instanceof HTMLButtonElement
				) {
					node.disabled = disabled;
				}
			});
		}

		async function updateEditorPreview() {
			if (editorNodes.preview) {
				editorNodes.preview.innerHTML = await renderPrivateMarkdown(
					editorNodes.body instanceof HTMLTextAreaElement ? editorNodes.body.value : '',
				);
			}
		}

			function resetEditor() {
				loadedPost = null;
				slugTouched = false;
				editorNodes.form?.reset();
				if (editorNodes.titleNode) editorNodes.titleNode.textContent = randomEditorPrompt();
				if (editorNodes.backLink instanceof HTMLAnchorElement) editorNodes.backLink.href = withBase('/post');
				if (editorNodes.saveButton instanceof HTMLButtonElement) editorNodes.saveButton.textContent = '发送喵喵！';
				setStatus(editorNodes.status, '');
				void updateEditorPreview();
			}

		function fillEditor(post) {
			loadedPost = post;
			slugTouched = true;
			if (editorNodes.title instanceof HTMLInputElement) editorNodes.title.value = post.title || '';
			if (editorNodes.slug instanceof HTMLInputElement) editorNodes.slug.value = post.slug || '';
			if (editorNodes.tags instanceof HTMLInputElement) {
				editorNodes.tags.value = Array.isArray(post.tags) ? post.tags.join(', ') : '';
			}
				if (editorNodes.body instanceof HTMLTextAreaElement) editorNodes.body.value = post.body || '';
				if (editorNodes.backLink instanceof HTMLAnchorElement) {
					editorNodes.backLink.href = withBase(`/post/${encodeURIComponent(post.slug)}`);
				}
				void updateEditorPreview();
			}

		async function loadEditor(slug) {
			resetEditor();
			if (!slug) {
				setEditorDisabled(false);
				return;
			}

			if (!supabase) return;
			const { data, error } = await supabase
				.from('love_posts')
				.select('slug,title,body,tags,author,hero_image_path,published_at')
				.eq('slug', slug)
				.maybeSingle();

			if (error) {
				setStatus(editorNodes.status, `读取失败：${error.message}`, 'error');
				return;
			}

			if (!data) {
				setStatus(editorNodes.status, '没有找到这篇日常。', 'error');
				return;
			}

			fillEditor(data);
			if (editorNodes.saveButton instanceof HTMLButtonElement) editorNodes.saveButton.textContent = '发送喵喵！';

			if (data.author !== currentCat) {
				setEditorDisabled(true);
				setStatus(editorNodes.status, `这篇由 ${catLabel(data.author)} 发布，当前账号不能编辑。`, 'error');
				return;
			}

			setEditorDisabled(false);
			if (editorNodes.slug instanceof HTMLInputElement) editorNodes.slug.disabled = true;
			setStatus(editorNodes.status, '');
		}

		function calculateStatValue(stat) {
			if (!stat.mode || !stat.target_date) return stat.value || '';
			const now = new Date();
			const target = new Date(`${stat.target_date}T00:00:00`);
			const oneDay = 1000 * 60 * 60 * 24;
			const raw =
				stat.mode === 'until' ? target.getTime() - now.getTime() : now.getTime() - target.getTime();
			return String(Math.max(0, Math.ceil(raw / oneDay)));
		}

		function statNumberValue(stat) {
			const raw = Number(calculateStatValue(stat));
			return Number.isFinite(raw) ? Math.max(0, Math.floor(raw)) : 0;
		}

		function renderScoreboard(value) {
			const number = String(Math.max(0, Number(value) || 0));
			const board = document.createElement('span');
			board.className = 'score-board';
			Array.from(number).forEach((digit) => {
				const tile = document.createElement('span');
				tile.className = 'score-tile';
				tile.textContent = digit;
				board.append(tile);
			});
			return board;
		}

			function renderStatCopy(value) {
				const span = document.createElement('span');
				span.className = 'stat-copy';
				span.innerHTML = renderInlineMarkdown(value);
				return span;
			}

			const statEditIcons = {
				edit: `
					<svg aria-hidden="true" viewBox="0 0 24 24">
						<path d="M12 20h9" />
						<path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" />
					</svg>
				`,
				save: `
					<svg aria-hidden="true" viewBox="0 0 24 24">
						<path d="M20 6 9 17l-5-5" />
					</svg>
				`,
			};

			function oneLineStatText(value) {
				return String(value || '').replace(/[\r\n]+/g, ' ');
			}

			function cloneStatForDraft(stat) {
				return {
					id: stat.id,
					label: stat.label || '',
					value: String(statNumberValue(stat)),
					suffix: stat.suffix || '',
					size: stat.size || 'medium',
					mode: null,
					target_date: null,
					sort_order: Number(stat.sort_order || 0),
					isNew: Boolean(stat.isNew),
				};
			}

			function activeStatItems() {
				return statEditMode ? statDraftItems : statItems;
			}

			function updateStatEditToggle() {
				if (!(statNodes.editToggle instanceof HTMLButtonElement)) return;
				statNodes.editToggle.setAttribute('aria-pressed', statEditMode ? 'true' : 'false');
				statNodes.editToggle.setAttribute('aria-label', statEditMode ? '保存数据' : '编辑数据');
				statNodes.editToggle.disabled = statSaveInProgress;
				statNodes.editToggle.innerHTML = statEditMode ? statEditIcons.save : statEditIcons.edit;
			}

			function beginStatEdit() {
				statDraftItems = statItems.map(cloneStatForDraft);
				statDeletedIds = new Set();
				statEditMode = true;
				updateStatEditToggle();
				renderStats();
				setStatus(statNodes.status, '');
			}

			function findDraftStat(id) {
				return statDraftItems.find((item) => item.id === id);
			}

			function updateDraftStatText(id, field, value) {
				const stat = findDraftStat(id);
				if (!stat) return;
				stat[field] = oneLineStatText(value);
			}

			function adjustDraftStat(id, delta) {
				const stat = findDraftStat(id);
				if (!stat) return;
				stat.value = String(Math.max(0, statNumberValue(stat) + delta));
				renderStats();
			}

			async function saveStatDrafts() {
				if (!supabase || statSaveInProgress) return;
				statSaveInProgress = true;
				updateStatEditToggle();
				statNodes.list?.setAttribute('aria-busy', 'true');
				setStatus(statNodes.status, '正在保存。');

				for (const id of statDeletedIds) {
					const { error } = await supabase.rpc('love_delete_stat', { stat_id: id });
					if (error) {
						statSaveInProgress = false;
						updateStatEditToggle();
						statNodes.list?.removeAttribute('aria-busy');
						setStatus(statNodes.status, `删除失败：${error.message}`, 'error');
						return;
					}
				}

				for (const stat of statDraftItems) {
					const { error } = await supabase.rpc('love_set_stat', {
						stat_id: stat.id,
						left_text: stat.label || '',
						right_text: stat.suffix || '',
						stat_value: statNumberValue(stat),
						stat_sort_order: Number(stat.sort_order || 0),
					});
					if (error) {
						statSaveInProgress = false;
						updateStatEditToggle();
						statNodes.list?.removeAttribute('aria-busy');
						setStatus(statNodes.status, `保存失败：${error.message}`, 'error');
						return;
					}
				}

				statSaveInProgress = false;
				statEditMode = false;
				statDraftItems = [];
				statDeletedIds = new Set();
				updateStatEditToggle();
				statNodes.list?.removeAttribute('aria-busy');
				await loadStats();
				setStatus(statNodes.status, '');
			}

			function renderStatRow(stat, index = 0) {
				const row = document.createElement('article');
				row.className = statEditMode ? 'stat-row is-editing' : 'stat-row';
				row.dataset.statId = stat.id;
				row.dataset.sortOrder = String(stat.sort_order ?? 0);
				row.style.setProperty('--row-index', String(index));
				const value = statNumberValue(stat);

				if (!statEditMode) {
					row.append(renderStatCopy(stat.label), renderScoreboard(value), renderStatCopy(stat.suffix));
					return row;
				}

				const removeButton = document.createElement('button');
				removeButton.className = 'stat-delete-button';
				removeButton.type = 'button';
				removeButton.textContent = '-';
				removeButton.setAttribute('aria-label', '删除这条记录');
				removeButton.addEventListener('click', () => {
					pendingStatDeleteId = stat.id;
					if (statNodes.deleteDialog instanceof HTMLDialogElement) statNodes.deleteDialog.showModal();
				});

				const left = document.createElement('input');
				left.className = 'stat-text-input';
				left.dataset.statLeft = 'true';
				left.type = 'text';
				left.value = stat.label || '';
				left.addEventListener('input', () => updateDraftStatText(stat.id, 'label', left.value));
				left.addEventListener('keydown', (event) => {
					if (event.key === 'Enter') {
						event.preventDefault();
						left.blur();
					}
				});

				const numberBox = document.createElement('span');
				numberBox.className = 'score-edit-wrap';
				numberBox.append(renderScoreboard(value));

				const plus = document.createElement('button');
				plus.className = 'score-adjust score-plus';
				plus.type = 'button';
				plus.textContent = '+';
				plus.setAttribute('aria-label', '数字加一');
				plus.addEventListener('click', () => adjustDraftStat(stat.id, 1));

				const minus = document.createElement('button');
				minus.className = 'score-adjust score-minus';
				minus.type = 'button';
				minus.textContent = '-';
				minus.disabled = value <= 0;
				minus.setAttribute('aria-label', '数字减一');
				minus.addEventListener('click', () => adjustDraftStat(stat.id, -1));
				numberBox.append(plus, minus);

				const right = document.createElement('input');
				right.className = 'stat-text-input';
				right.dataset.statRight = 'true';
				right.type = 'text';
				right.value = stat.suffix || '';
				right.addEventListener('input', () => updateDraftStatText(stat.id, 'suffix', right.value));
				right.addEventListener('keydown', (event) => {
					if (event.key === 'Enter') {
						event.preventDefault();
						right.blur();
					}
				});

				row.append(removeButton, left, numberBox, right);
				return row;
			}

			function renderStats() {
				if (!statNodes.list) return;
				statNodes.list.innerHTML = '';
				statNodes.list.dataset.mode = statEditMode ? 'edit' : 'view';
				const items = activeStatItems();
				if (!items.length) {
					renderEmpty(statNodes.list, statEditMode ? '还没有记录，点下面的加号创建。' : '还没有记录。');
				} else {
					items.forEach((stat, index) => statNodes.list.append(renderStatRow(stat, index)));
				}

				if (statEditMode) {
					const addButton = document.createElement('button');
					addButton.className = 'stat-add-button';
					addButton.type = 'button';
					addButton.textContent = '+';
					addButton.setAttribute('aria-label', '创建新记录');
					addButton.addEventListener('click', () => {
						const nextOrder =
							statDraftItems.reduce((max, item) => Math.max(max, Number(item.sort_order || 0)), 0) + 10;
						const id = `stat-${Date.now()}-${Math.random().toString(16).slice(2, 8)}`;
						statDraftItems.push({
							id,
							label: '',
							value: '0',
							suffix: '',
							size: 'medium',
							mode: null,
							target_date: null,
							sort_order: nextOrder,
							isNew: true,
						});
						renderStats();
					});
					statNodes.list.append(addButton);
				}
			}

			async function loadStats(options = {}) {
				if (!supabase || !statNodes.list) return;
				const { data, error } = await supabase
					.from('love_stats')
					.select('id,label,value,suffix,size,mode,target_date,sort_order')
					.order('sort_order', { ascending: true });

				if (error) {
					setStatus(statNodes.status || statNodes.empty, `数据读取失败：${error.message}`, 'error');
					return;
				}

				if (!options.preserveMode) {
					statEditMode = false;
					statDraftItems = [];
					statDeletedIds = new Set();
				}
				statItems = data || [];
				if (statEditMode && !statDraftItems.length) statDraftItems = statItems.map(cloneStatForDraft);
				updateStatEditToggle();
				renderStats();
				setStatus(statNodes.status, '');
			}

		async function renderTimelineEvent(event) {
