		async function loadRoute() {
			currentRoute = parseRoute();
			showView(currentRoute.view);
			updateNav(currentRoute.section);
			document.title = currentRoute.title === 'lzxszty' ? 'lzxszty' : `${currentRoute.title} | lzxszty`;

			if (currentRoute.view === 'home') await loadHome();
			else if (currentRoute.view === 'post-list') await loadPostList(currentRoute.page || 1);
			else if (currentRoute.view === 'post-detail') await loadPostDetail(currentRoute.slug);
			else if (currentRoute.view === 'post-edit') await loadEditor(currentRoute.slug || '');
			else if (currentRoute.view === 'stat') await loadStats();
			else if (currentRoute.view === 'timeline') await loadTimeline();
			else if (currentRoute.view === 'gallery') await loadGallery();
			else if (currentRoute.view === 'meow') await loadMeow();
			else if (currentRoute.view === 'achievement') await loadAchievements();
			else if (currentRoute.view === 'game') await loadGames();
			else if (currentRoute.view === 'about') await loadAbout();
		}

		function reloadPostRouteIfActive() {
			if (currentRoute.section === 'post') void loadRoute();
		}

			function reloadStatRouteIfActive() {
				if (currentRoute.section === 'stat' && !statEditMode) void loadStats();
			}

		function reloadMeowRouteIfActive() {
			if (currentRoute.section === 'meow') void loadMeow();
		}

		function setupRealtime() {
			if (!supabase) return;
			if (!postChannel) {
				postChannel = supabase
					.channel('post-private')
					.on(
						'postgres_changes',
						{ event: '*', schema: 'public', table: 'love_posts' },
						reloadPostRouteIfActive,
					)
					.subscribe();
			}

			if (!statChannel) {
				statChannel = supabase
					.channel('stat-private')
					.on(
						'postgres_changes',
						{ event: '*', schema: 'public', table: 'love_stats' },
						reloadStatRouteIfActive,
					)
					.subscribe();
			}

			if (!meowChannel) {
				meowChannel = supabase
					.channel('meow-private')
					.on(
						'postgres_changes',
						{ event: '*', schema: 'public', table: 'love_cats' },
						reloadMeowRouteIfActive,
					)
					.on(
						'postgres_changes',
						{ event: '*', schema: 'public', table: 'love_meow_messages' },
						reloadMeowRouteIfActive,
					)
					.subscribe();
			}
		}

		postNodes.deleteButton?.addEventListener('click', async () => {
			if (!(postNodes.deleteButton instanceof HTMLButtonElement)) return;
			const slug = postNodes.deleteButton.dataset.slug;
			if (!slug) return;
			pendingDeleteSlug = slug;
			if (postNodes.deleteDialog instanceof HTMLDialogElement) postNodes.deleteDialog.showModal();
		});

		postNodes.deleteCancel?.addEventListener('click', () => {
			pendingDeleteSlug = '';
			if (postNodes.deleteDialog instanceof HTMLDialogElement) postNodes.deleteDialog.close();
		});

		postNodes.deleteDialog?.addEventListener('click', (event) => {
			if (event.target === postNodes.deleteDialog && postNodes.deleteDialog instanceof HTMLDialogElement) {
				pendingDeleteSlug = '';
				postNodes.deleteDialog.close();
			}
		});

		postNodes.deleteConfirm?.addEventListener('click', async () => {
			if (!pendingDeleteSlug) return;
			if (postNodes.deleteConfirm instanceof HTMLButtonElement) postNodes.deleteConfirm.disabled = true;
			const { error } = await supabase.rpc('love_delete_post', { post_slug: pendingDeleteSlug });
			if (postNodes.deleteConfirm instanceof HTMLButtonElement) postNodes.deleteConfirm.disabled = false;

			if (error) {
				setStatus(postNodes.detailStatus, `删除失败：${error.message}`, 'error');
				return;
			}
			pendingDeleteSlug = '';
			if (postNodes.deleteDialog instanceof HTMLDialogElement) postNodes.deleteDialog.close();
			window.location.hash = '#/post';
		});

			statNodes.editToggle?.addEventListener('click', () => {
				if (statSaveInProgress) return;
				if (!statEditMode) {
					beginStatEdit();
					return;
				}
				void saveStatDrafts();
			});

		statNodes.deleteCancel?.addEventListener('click', () => {
			pendingStatDeleteId = '';
			if (statNodes.deleteDialog instanceof HTMLDialogElement) statNodes.deleteDialog.close();
		});

		statNodes.deleteDialog?.addEventListener('click', (event) => {
			if (event.target === statNodes.deleteDialog && statNodes.deleteDialog instanceof HTMLDialogElement) {
				pendingStatDeleteId = '';
				statNodes.deleteDialog.close();
			}
		});

			statNodes.deleteConfirm?.addEventListener('click', () => {
				if (!pendingStatDeleteId) return;
				const removed = statDraftItems.find((item) => item.id === pendingStatDeleteId);
				statDraftItems = statDraftItems.filter((item) => item.id !== pendingStatDeleteId);
				if (removed && !removed.isNew) {
					statDeletedIds.add(removed.id);
				}
				pendingStatDeleteId = '';
				if (statNodes.deleteDialog instanceof HTMLDialogElement) statNodes.deleteDialog.close();
				renderStats();
			});

		editorNodes.title?.addEventListener('input', () => {
			if (
				slugTouched ||
				!(editorNodes.title instanceof HTMLInputElement) ||
				!(editorNodes.slug instanceof HTMLInputElement)
			) {
				return;
			}
			editorNodes.slug.value = slugify(editorNodes.title.value);
		});

		editorNodes.slug?.addEventListener('input', () => {
			slugTouched = true;
			if (editorNodes.slug instanceof HTMLInputElement) editorNodes.slug.value = slugify(editorNodes.slug.value);
		});

		editorNodes.body?.addEventListener('input', () => void updateEditorPreview());

		editorNodes.imageUploadButton?.addEventListener('click', () => {
			if (editorNodes.imageInput instanceof HTMLInputElement) editorNodes.imageInput.click();
		});

		editorNodes.imageInput?.addEventListener('change', async () => {
			if (!(editorNodes.imageInput instanceof HTMLInputElement)) return;
			await insertEditorImages(editorNodes.imageInput.files);
			editorNodes.imageInput.value = '';
		});

		editorNodes.body?.addEventListener('paste', async (event) => {
			if (!(event instanceof ClipboardEvent)) return;
			const files = Array.from(event.clipboardData?.items || [])
				.filter((item) => item.kind === 'file' && item.type.startsWith('image/'))
				.map((item) => item.getAsFile())
				.filter(Boolean);
			if (!files.length) return;
			event.preventDefault();
			await insertEditorImages(files);
		});

		editorNodes.form?.addEventListener('submit', async (event) => {
			event.preventDefault();
			if (
				!(editorNodes.title instanceof HTMLInputElement) ||
				!(editorNodes.slug instanceof HTMLInputElement) ||
				!(editorNodes.tags instanceof HTMLInputElement) ||
				!(editorNodes.body instanceof HTMLTextAreaElement)
			) {
				return;
			}

			if (!editorNodes.title.value.trim()) {
				setStatus(editorNodes.status, '标题还没写。', 'error');
				editorNodes.title.focus();
				return;
			}

			if (!editorNodes.slug.value.trim()) {
				setStatus(editorNodes.status, 'Post name 还没写。', 'error');
				editorNodes.slug.focus();
				return;
			}

			if (!editorNodes.body.value.trim()) {
				setStatus(editorNodes.status, '正文还没写。', 'error');
				editorNodes.body.focus();
				return;
			}

			setEditorDisabled(true);
			setStatus(editorNodes.status, '正在保存。');
			const { data, error } = await supabase.rpc('love_save_post', {
				post_slug: editorNodes.slug.value,
				post_title: editorNodes.title.value,
				post_summary: '',
				post_body: editorNodes.body.value,
				post_tags: parseTags(editorNodes.tags.value),
				post_hero_image_path: loadedPost?.hero_image_path || null,
			});

			if (error) {
				setStatus(editorNodes.status, `保存失败：${error.message}`, 'error');
				setEditorDisabled(false);
				return;
			}

			const savedSlug = data?.slug || editorNodes.slug.value;
			setStatus(editorNodes.status, '已保存。', 'ok');
			window.location.hash = `#/post/${encodeURIComponent(savedSlug)}`;
		});

		galleryNodes.close?.addEventListener('click', () => {
			if (galleryNodes.dialog instanceof HTMLDialogElement) galleryNodes.dialog.close();
		});

		galleryNodes.dialog?.addEventListener('click', (event) => {
			if (event.target === galleryNodes.dialog && galleryNodes.dialog instanceof HTMLDialogElement) {
				galleryNodes.dialog.close();
			}
		});

		timelineNodes.frame?.addEventListener(
			'wheel',
			(event) => {
				if (!(event instanceof WheelEvent)) return;
				event.preventDefault();
				timelineNodes.frame.scrollLeft += event.deltaY + event.deltaX;
			},
			{ passive: false },
		);

		setEditorDisabled(true);
		setMeowControlsDisabled(true);

		window.addEventListener('hashchange', () => {
			if (document.documentElement.dataset.authState === 'unlocked') void loadRoute();
		});

		onPrivateContentReady(async (detail) => {
			currentCat = detail?.accountId || document.documentElement.dataset.accountId || '';
			setupRealtime();
			await loadRoute();
		});

		window.addEventListener('beforeunload', () => {
			if (postChannel) void supabase.removeChannel(postChannel);
			if (statChannel) void supabase.removeChannel(statChannel);
			if (meowChannel) void supabase.removeChannel(meowChannel);
		});
	</script>
</Layout>

