		async function performMeowAction(action) {
			setMeowControlsDisabled(true);
			const { error } = await supabase.rpc('love_perform_cat_action', { action_name: action });

			if (error) {
				setStatus(meowNodes.status, `操作失败：${error.message}`, 'error');
			} else {
				setStatus(meowNodes.status, action === 'feed' ? '已经给对方投食。' : '小猫喵喵叫了一声。', 'ok');
				await loadCats();
			}
			setMeowControlsDisabled(false);
		}

		async function sendMeowMessage(message) {
			const { error } = await supabase.rpc('love_add_meow_message', { message_body: message });
			if (error) {
				setStatus(meowNodes.status, `留言失败：${error.message}`, 'error');
				return;
			}
			if (meowNodes.input instanceof HTMLInputElement) meowNodes.input.value = '';
			setStatus(meowNodes.status, '留言已发送。', 'ok');
			await loadMessages();
		}

		function bindMeowEvents() {
			if (meowEventsBound) return;
			meowEventsBound = true;
			meowNodes.feedButton?.addEventListener('click', () => void performMeowAction('feed'));
			meowNodes.meowButton?.addEventListener('click', () => void performMeowAction('meow'));
			meowNodes.form?.addEventListener('submit', (event) => {
				event.preventDefault();
				const message = meowNodes.input instanceof HTMLInputElement ? meowNodes.input.value.trim() : '';
				if (message) void sendMeowMessage(message);
			});
		}

		async function loadMeow() {
			bindMeowEvents();
			if (!currentCat) {
				setStatus(meowNodes.status, '无法识别当前账号对应的小猫。', 'error');
				return;
			}
			setElementText(
				meowNodes.activeTitle,
				currentCat === 'black' ? '正在操作黑色小猫' : '正在操作白色小猫',
			);
			await Promise.all([loadCats(), loadMessages()]);
			setMeowControlsDisabled(false);
			setStatus(meowNodes.status, '小猫已加载。', 'ok');
		}

