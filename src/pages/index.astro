			article.className = `meow-bubble ${item.author === currentCat ? 'bubble-own' : 'bubble-partner'}`;

			const meta = document.createElement('time');
			meta.textContent = `${catLabel(item.author)} · ${formatDate(item.created_at)}`;
			article.append(meta);

