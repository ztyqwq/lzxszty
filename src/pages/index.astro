			footer.innerHTML = `
				<span class="post-star" aria-label="未收藏">
					<svg aria-hidden="true" viewBox="0 0 24 24">
						<path d="M12 3.8l2.45 5.05 5.55.82-4.02 3.92.95 5.53L12 16.5l-4.93 2.62.95-5.53L4 9.67l5.55-.82L12 3.8Z" />
					</svg>
				</span>
				<span class="post-card-stats" aria-label="互动数据">
					<span aria-label="点赞">
						<svg class="stat-heart" aria-hidden="true" viewBox="0 0 24 24">
							<path d="M20.7 5.7c-1.7-1.9-4.4-1.9-6.1-.2L12 8.1 9.4 5.5C7.7 3.8 5 3.8 3.3 5.7c-1.8 2-1.7 5 .2 6.9L12 21l8.5-8.4c1.9-1.9 2-4.9.2-6.9Z" />
						</svg>
						${likeCount}
					</span>
					<span aria-label="评论">
						<svg class="stat-comment" aria-hidden="true" viewBox="0 0 24 24">
							<path d="M4.5 5.5h15v10.2h-7.1L8 19.2v-3.5H4.5Z" />
						</svg>
						${commentCount}
					</span>
				</span>
			`;

				content.append(cat, title, summary);
				card.append(content, footer);

			if (previewImages.length) {
				const imageBox = document.createElement('a');
				imageBox.className = `post-card-media media-count-${previewImages.length}`;
				imageBox.href = title.href;
				previewImages.forEach((imageUrl, index) => {
					const image = document.createElement('img');
					image.src = imageUrl;
					image.alt = `${post.title || '日常'} 图片 ${index + 1}`;
					imageBox.append(image);
