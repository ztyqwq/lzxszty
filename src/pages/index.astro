---
import { heroMaterials } from '../data/materials';
import Layout from '../layouts/Layout.astro';

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;

const materials = heroMaterials.map((item) => ({
	...item,
	src: `${baseUrl}${item.src}`,
}));
---

<Layout title="lzxszty" description="lzxszty 的独立恋爱区入口。">
	<main class="home-shell">
		<section class="home-hero" aria-labelledby="site-title">
			<div class="hero-copy">
				<p class="eyebrow">lzxszty</p>
				<h1 id="site-title">一些共同生活的存档</h1>
				<p class="page-lead">这里先放一张从素材库随机抽取的首页图；之后可以换成照片、插画或更有互动感的封面。</p>
			</div>

			<figure class="hero-visual soft-panel">
				<img
					src={materials[0].src}
					alt={materials[0].alt}
					data-random-hero
					data-materials={JSON.stringify(materials)}
				/>
				<figcaption>{materials[0].title}</figcaption>
			</figure>
		</section>
	</main>

	<script>
		const image = document.querySelector('[data-random-hero]');
		if (image instanceof HTMLImageElement) {
			const materials = JSON.parse(image.dataset.materials || '[]');
			const pick = materials[Math.floor(Math.random() * materials.length)];
			if (pick) {
				image.src = pick.src;
				image.alt = pick.alt;
				const caption = image.closest('figure')?.querySelector('figcaption');
				if (caption) caption.textContent = pick.title;
			}
		}
	</script>
</Layout>

<style>
	.home-shell {
		width: min(1120px, calc(100% - 40px));
		margin: 0 auto;
		padding: 4rem 0 5rem;
	}

	.home-hero {
		display: grid;
		grid-template-columns: minmax(0, 0.72fr) minmax(320px, 1fr);
		gap: 3rem;
		align-items: center;
		min-height: calc(100svh - 10rem);
	}

	.hero-copy {
		max-width: 560px;
	}

	h1 {
		margin: 0;
		color: var(--text);
		font-size: clamp(2.4rem, 7vw, 5.2rem);
		font-weight: 680;
		line-height: 1.08;
		letter-spacing: 0;
	}

	.hero-visual {
		overflow: hidden;
		margin: 0;
	}

	.hero-visual img {
		display: block;
		width: 100%;
		aspect-ratio: 5 / 3;
		object-fit: cover;
	}

	.hero-visual figcaption {
		padding: 0.85rem 1rem;
		border-top: 1px solid var(--line);
		color: var(--muted);
		font-size: 0.9rem;
	}

	@media (max-width: 820px) {
		.home-shell {
			width: min(100% - 28px, 680px);
		}

		.home-hero {
			grid-template-columns: 1fr;
			min-height: auto;
		}
	}
</style>
